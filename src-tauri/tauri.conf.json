{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RIFT",
  "version": "0.1.0",
  "identifier": "app.riftsys.desktop",
  "build": {
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": "pnpm dev:next"
  },
  "app": {
    "windows": [
      {
        "title": "RIFT",
        "url": "https://riftsys.app",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
